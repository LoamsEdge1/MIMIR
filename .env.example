# MIMIR environment — copy to .env and fill in.
# .env is gitignored. Never commit real values.

# Telegram bot (Phase 6). Treat the token as a password:
# anyone holding it can message you as MIMIR.
MIMIR_TELEGRAM_BOT_TOKEN=
MIMIR_TELEGRAM_CHAT_ID=

# Ollama endpoint
MIMIR_OLLAMA_HOST=http://127.0.0.1:11434

# Daemon bind address. Localhost only until Phase 6.
MIMIR_HOST=127.0.0.1
MIMIR_PORT=8756

# Overrides config.yaml data_root when set.
MIMIR_DATA_ROOT=
